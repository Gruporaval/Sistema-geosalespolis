# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/salesopolis_cadastro?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=604800

# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# S3 / Object Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=salesopolis-cadastro-attachments

# External APIs
NOMINATIM_URL=https://nominatim.openstreetmap.org
VIACEP_URL=https://viacep.com.br/ws

# Monitoring (Prometheus, Grafana, etc.)
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3001

# Email (para notificações de suporte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificacoes@salesopolis.sp.gov.br
SMTP_PASSWORD=your-email-password
SMTP_FROM=Sistema Cadastro <notificacoes@salesopolis.sp.gov.br>

# Differential Privacy
DP_DEFAULT_EPSILON=0.1
DP_DEFAULT_DELTA=0.00001
DP_MIN_CELL_SIZE=5

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_PUBLIC_MAX=30

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/

# Feature Flags
ENABLE_MFA=false
ENABLE_ELASTICSEARCH=false
ENABLE_GEOSERVER=false
